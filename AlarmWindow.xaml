<Window x:Class="AlarmGiliran.AlarmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}"
        Title="Waktunya berganti giliran" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" WindowStartupLocation="CenterOwner"
        Topmost="True" ShowInTaskbar="False" Background="#19233F" Closing="OnClosing">
  <Viewbox Stretch="Uniform" Margin="40">
    <Grid Width="900" Height="650">
      <Ellipse Width="460" Height="460" Fill="#212E50" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-120,0,0" />
      <Ellipse Width="360" Height="360" Fill="#263454" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-90,-80" />
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="790">
        <Border Width="82" Height="82" CornerRadius="26" Background="#394A77" HorizontalAlignment="Center" Margin="0,0,0,26">
          <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#C3CDFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="WAKTU BERMAIN BERGANTI" FontSize="14" FontWeight="SemiBold" Foreground="#ABB9E4" HorizontalAlignment="Center" />
        <TextBlock Text="Saatnya giliran:" FontSize="40" Foreground="White" HorizontalAlignment="Center" Margin="0,22,0,0" />
        <TextBlock x:Name="PlayerName" Text="Lukman" FontSize="98" FontWeight="Bold" Foreground="#B7C3FF" HorizontalAlignment="Center" Margin="0,0,0,12" />
        <TextBlock x:Name="DurationHint" FontSize="19" Foreground="#D2DAEF" HorizontalAlignment="Center" />
        <Button x:Name="StopButton" Content="Stop" Width="310" FontSize="24" Padding="24,19" Background="#8D9CFF" Foreground="#182341" Click="StopClick" Margin="0,32,0,0" />
        <TextBlock x:Name="StopHint" Text="Tekan Stop untuk mematikan nada dan memulai giliran." FontSize="14" Foreground="#ABB9CE" HorizontalAlignment="Center" Margin="0,18,0,0" />
      </StackPanel>
    </Grid>
  </Viewbox>
</Window>
