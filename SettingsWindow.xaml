<Window x:Class="AlarmGiliran.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}"
        Title="Pengaturan alarm" Width="470" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False">
  <Border BorderBrush="#DCE1EF" BorderThickness="1" Padding="30" Background="#F6F7FB">
    <StackPanel>
      <TextBlock Text="Pengaturan" FontSize="26" FontWeight="Bold" />
      <TextBlock Text="Waktu yang adil untuk keduanya." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,26" />
      <TextBlock Text="Durasi per anak (menit)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
      <TextBox x:Name="MinutesInput" AutomationProperties.Name="Durasi dalam menit" MaxLength="3" />
      <TextBlock Text="Masukkan 1–180 menit. Berlaku untuk kedua anak." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,22" />
      <TextBlock Text="Pemain pertama" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
      <ComboBox x:Name="FirstPlayerInput" AutomationProperties.Name="Pemain pertama"><ComboBoxItem Content="Imran" /><ComboBoxItem Content="Lukman" /></ComboBox>
      <TextBlock x:Name="SettingsNote" Text="Pengaturan tersimpan untuk pemakaian berikutnya." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" />
      <TextBlock x:Name="ErrorText" Foreground="#B54747" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite" />
      <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Button Content="Kembali" Click="BackClick" /><Button Grid.Column="2" Content="Simpan" Style="{StaticResource PrimaryButton}" Click="SaveClick" />
      </Grid>
      <Border Height="1" Background="#DFE4EF" Margin="0,0,0,20" />
      <Button Content="Keluar aplikasi" Background="#FBEAEA" Foreground="#B54747" Click="ExitClick" />
      <TextBlock Text="Mengakhiri sesi dan mematikan alarm." FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,9,0,0" />
    </StackPanel>
  </Border>
</Window>
